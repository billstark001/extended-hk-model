# External runtime and workspace inputs
SMP_BINARY_PATH=../social-media-models/smp
SMP_BATCH_BINARY_PATH=../social-media-models/smp-batch
SMP_PROBE_BINARY=../social-media-models/smp-probe
# On Windows, point these three settings to explicit .exe files. Versioned
# builds can live in outputs/runtime/smp/<revision>/ without replacing old producers.
SIMULATION_WS_PATH=./sim_ws.json
SIMULATION_STAT_DIR=./outputs/experiments/paper
SIMULATION_INSTANCE_NAME=gradation
STAT_THREAD_COUNT=6

# Read-only formal figures: choose an exact analysis revision and sources.
# Use EHK_STATS_ORIGIN for one source OR EHK_STATS_ORIGINS for an explicit union.
# EHK_STATS_ORIGIN=original-data2
# EHK_STATS_ORIGINS=original-data2,original-data3
# EHK_ANALYSIS_ID=e499b1ab5ff7ddc6480c5578127996e1945eecfd78af2f9a605f0fb7b93a267e
# EHK_IW_CUTOFF=0.6
# Main-scan/history-pooled figures default to the original design (St0/Op0,2,6).
# Pass --history-scope zero for the auxiliary restriction; its outputs stay separate.
# Explicit --database/--origin/--analysis-id/--output are recommended for receipts.

# Theory experiments: generated outputs stay ignored; large inputs may be external
EHK_PAPER_THEORY_OUTPUT_DIR=./outputs/experiments/paper_theory

# Original paper's mechanism probe
EHK_SOCIAL_FORCE_INPUT_DIR=./outputs/experiments/paper/mechanism_cases/raw
EHK_SOCIAL_FORCE_OUTPUT_DIR=./outputs/experiments/drift_probe

# Paper experiment outputs
EHK_PAPER_OUTPUT_DIR=./outputs/experiments/paper
EHK_MAIN_SCAN_OUTPUT_DIR=./outputs/experiments/paper/main_scan
EHK_EPSILON_SCAN_OUTPUT_DIR=./outputs/experiments/paper/epsilon_scan
EHK_REPLICATE_OUTPUT_DIR=./outputs/experiments/paper/replicate
EHK_MECHANISM_OUTPUT_DIR=./outputs/experiments/paper/mechanism_cases
EHK_PATHWAY_OUTPUT_DIR=./outputs/experiments/paper/pathway_index
EHK_ILLUSTRATION_OUTPUT_DIR=./outputs/experiments/paper/illustrations
